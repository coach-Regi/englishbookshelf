{
  "name": "english-bookshelf-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":     "vite",
"build": "vite build",
    "preview": "vite preview",
    "lint":    "eslint src --ext ts,tsx --report-unused-disable-directives",
    "test":    "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react":            "^18.3.1",
    "react-dom":        "^18.3.1",
    "react-router-dom": "^6.26.2",

    "axios":            "^1.7.7",

    "zustand":          "^4.5.5",

    "@tanstack/react-query":         "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",

    "pdfjs-dist":  "^4.6.82",
    "react-pdf":   "^9.1.0",

    "@dnd-kit/core":       "^6.1.0",
    "@dnd-kit/utilities":  "^3.2.2",

    "date-fns":       "^3.6.0",
    "clsx":           "^2.1.1",
    "tailwind-merge": "^2.5.3",
    "lucide-react":   "^0.451.0"
  },
  "devDependencies": {
    "@types/react":            "^18.3.11",
